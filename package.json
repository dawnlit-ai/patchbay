{
  "name": "patchbay",
  "productName": "Patchbay",
  "version": "0.1.0",
  "private": true,
  "description": "Wire email-processing flows like a patchbay: drag nodes, connect ports, and watch every email travel a traced path. Outlook in, Claude skills out. Built by Dawnlit.",
  "author": "Dawnlit",
  "license": "AGPL-3.0-or-later",
  "main": ".vite/build/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "file:../outlook-bridge": false
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "dist": "electron-forge package && node scripts/dist.mts",
    "typecheck": "tsc --noEmit",
    "bundle:check": "esbuild --bundle --platform=node --format=cjs --outdir=.selftest --out-extension:.js=.cjs --external:electron --external:@anthropic-ai/claude-agent-sdk --external:@dawnlit/outlook-bridge --log-level=warning",
    "mcpcheck": "npm run bundle:check -- scripts/mcpcheck.ts && electron .selftest/mcpcheck.cjs",
    "selftest": "npm run bundle:check -- scripts/selftest.ts && electron .selftest/selftest.cjs",
    "postinstall": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.293",
    "@dawnlit/outlook-bridge": "file:../outlook-bridge",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xyflow/react": "^12.11.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "velopack": "1.2.161",
    "zod": "^4.6.5"
  }
}
